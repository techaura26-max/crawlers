---
import Svgg from "@c/svg/Svgg.astro"
import { categories } from "../tools/categories"
import { getToolsByCategory } from "../tools/registry"
const liveCategories = categories.filter(
  category => getToolsByCategory(category.id).length
)
---

<nav
  class="site-nav pointer-events-none fixed inset-x-0 top-0 z-40 flex w-full items-start justify-between"
  aria-label="Main navigation"
>
  <a
    href="/"
    aria-label="Crawlers home"
    class="site-brand pointer-events-auto flex flex-col"
  >
    <div data-module="logo">
      <Svgg name="logo" class="w-[9.5rem] md:w-[8rem]" />
    </div>
  </a>

  <div class="site-nav-actions pointer-events-auto">
    <span class="site-nav-index" aria-label={`${categories.length} categories`}>
      INDEX / {String(categories.length).padStart(2, "0")}
    </span>
    {
      liveCategories.length > 0 && (
        <a class="site-nav-cta" href="/audio/">
          <span>Open audio tool</span>
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</nav>

<style>
  .site-nav {
    padding: 1.25rem max(1.25rem, var(--gx));
  }

  .site-brand {
    padding: 0.7rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.85rem;
    background: rgba(7, 7, 7, 0.34);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(14px);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .site-brand:hover,
  .site-brand:focus-visible {
    border-color: rgba(var(--active-rgb), 0.48);
    background: rgba(12, 12, 12, 0.62);
    outline: none;
  }

  .site-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: "Geist Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-nav-index,
  .site-nav-cta {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(7, 7, 7, 0.34);
    backdrop-filter: blur(14px);
  }

  .site-nav-index {
    padding: 0 1rem;
    color: rgba(255, 255, 255, 0.48);
  }

  .site-nav-cta {
    gap: 0.85rem;
    padding: 0 0.5rem 0 1rem;
    color: #fff;
    text-decoration: none;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-nav-cta span:last-child {
    display: grid;
    width: 1.85rem;
    height: 1.85rem;
    place-items: center;
    border-radius: 50%;
    color: #080808;
    background: var(--active-accent);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-nav-cta:hover,
  .site-nav-cta:focus-visible {
    border-color: rgba(var(--active-rgb), 0.48);
    outline: none;
    transform: translateY(-1px);
  }

  .site-nav-cta:hover span:last-child,
  .site-nav-cta:focus-visible span:last-child {
    transform: rotate(45deg);
  }

  @media (max-width: 640px) {
    .site-nav {
      padding: 1rem;
    }

    .site-brand {
      padding: 0.58rem 0.65rem;
    }

    .site-nav-index {
      display: none;
    }

    .site-nav-cta {
      min-height: 2.55rem;
      padding-left: 0.85rem;
      font-size: 0.65rem;
    }

    .site-nav-cta span:first-child {
      max-width: 3.3rem;
      line-height: 1.15;
    }

    .site-nav-cta span:last-child {
      width: 1.65rem;
      height: 1.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-brand,
    .site-nav-cta,
    .site-nav-cta span:last-child {
      transition-duration: 0.01ms;
    }
  }
</style>
