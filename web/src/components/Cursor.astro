---

---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-50 hidden md:block"
>
  <div data-module="cursor" class="size-[.6rem]">
    <div class="absolute flex size-[1px] items-center justify-center">
      <div cursor-main class="absolute size-[.4rem] bg-white"></div>
    </div>

    <div
      cursor-circle-w
      class="absolute flex size-[1px] items-center justify-center"
    >
      <div
        cursor-circle
        class="absolute grid size-[1.2rem] place-items-center rounded-full outline"
      >
        <span cursor-open>OPEN</span>
        <span cursor-drag>DRAG</span>
      </div>
    </div>
  </div>
</div>

<style>
  /** -- CURSOR */

  /* (*) REMOVE FROM MOBILE */

  /* remove on links and shit */
  body:has(nav:hover) [data-module="cursor"] > div {
    transform: scale(0.2);
    transition: transform 0.4s;
  }

  body:has(a:hover) [data-module="cursor"] [cursor-main],
  body:has(button:not([data-tools-trigger]):hover)
    [data-module="cursor"]
    [cursor-main],
  body:has([data-no-cursor]:hover) [data-module="cursor"] [cursor-main] {
    transform: scale(0);
    transition: transform 0.4s;
  }

  body:has(a:hover) [data-module="cursor"] [cursor-circle],
  body:has(button:not([data-tools-trigger]):hover)
    [data-module="cursor"]
    [cursor-circle],
  body:has([data-no-cursor]:hover) [data-module="cursor"] [cursor-circle] {
    transform: scale(0);
    transition: transform 0.4s;
  }

  /* out/in */
  [data-module="cursor"] {
    transition: opacity 0.2s;
  }

  body.mouse-out [data-module="cursor"] {
    opacity: 0;
  }

  [data-module="cursor"] [cursor-main] {
    transition:
      transform 0.4s,
      border-radius 0.4s;
    transform: scale(1);
  }

  /* down/up */
  body.mouse-down [data-module="cursor"] [cursor-main] {
    transform: scale(0.8);
    border-radius: 100%;
  }

  [cursor-circle-w] {
    transition: transform 0.8s;

    transform: scale(0);
    transition-delay: 0.3s;
  }

  body:not(:has([data-module="fslider"]:hover)) [cursor-circle-w] {
    transform: scale(0);
    transition: transform 0.2s;
  }

  body:has([data-module="fslider"]:hover) [cursor-circle-w] {
    transform: scale(1);
    transition: transform 0.2s;
  }

  [cursor-circle] {
    color: rgba(255, 255, 255, 0.72);
    outline-color: rgba(255, 255, 255, 0.5);
    background: rgba(7, 7, 7, 0.16);
    backdrop-filter: blur(2px);
    transition:
      width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s ease,
      outline-color 0.3s ease,
      background-color 0.3s ease,
      transform 0.4s;
    transform: scale(1);
  }

  [cursor-circle] span {
    position: absolute;
    font-family: "Geist Mono", monospace;
    font-size: 0.48rem;
    letter-spacing: 0.12em;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  body:has([data-tools-trigger]:hover) [cursor-circle] {
    width: 3.65rem;
    height: 3.65rem;
    color: #070707;
    outline-color: var(--active-accent);
    background: var(--active-accent);
  }

  body:has([data-tools-trigger]:hover):not(.mouse-dragging) [cursor-open] {
    opacity: 1;
  }

  body.mouse-dragging:has([data-module="fslider"]:hover) [cursor-drag] {
    opacity: 1;
  }

  body.mouse-dragging:has([data-module="fslider"]:hover) [cursor-open] {
    opacity: 0;
  }

  body.mouse-down [cursor-circle] {
    transform: scale(0.88);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-module="cursor"] *,
    [data-module="cursor"] {
      transition-duration: 0.01ms !important;
    }
  }
</style>
