---
import Svgg from "~/components/svg/Svgg.astro"
import { SLIDER_FOOD } from "../../../content"

const SLIDES = Array.from({ length: SLIDER_FOOD.length }, (_, i) => i)
---

<section
  style="--slide-w: clamp(18rem, 25vw, 30rem)"
  class="gap-lg flex w-full flex-col py-4"
  data-module="fslider"
  data-panel-open="false"
>
  <!-- slider -->
  <div class="w-full overflow-clip">
    <ul
      data-slider="wrapper"
      class="ml-[calc((50vw-var(--slide-w)/2)-2rem)] flex text-[.8em]"
    >
      {
        SLIDER_FOOD.map((slide, i) => (
          <li
            class:list={[
              "relative z-2 flex shrink-0 flex-col gap-2 px-[2rem]",
              i === 0 && "active",
            ]}
          >
            <button
              type="button"
              data-gl
              data-tools-trigger
              data-section-index={i}
              aria-controls="tools-panel"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-label={`Open ${slide.copy.name}`}
              class="tools-trigger relative z-10 block aspect-[4/4.5] w-[var(--slide-w)] appearance-none border-0 bg-transparent p-0 text-white md:aspect-[4/5.5]"
            >
              <span class="sr-only">Open {slide.copy.name}</span>
              <span class="tools-trigger-label" aria-hidden="true">
                Explore <span>↗</span>
              </span>
            </button>

            {/* centered slide name */}
            <div class="flex justify-center px-2">
              <h2
                data-module="text"
                data-type="chars"
                class="text-center text-xl font-semibold tracking-tighter uppercase"
              >
                {slide.copy.name}
              </h2>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- bottom ui -->
  <div data-no-cursor class="relative flex justify-center -outline-offset-1">
    <div data-slider="controls" class="flex flex-col gap-2">
      <ul class="flex gap-[1rem]">
        {
          SLIDES.map((slide, i) => (
            <li
              data-module="alpha"
              data-delay={1 + i * 0.2}
              class:list={i === 0 && "active"}
            >
              <button aria-label={`slide number ${slide}`}>
                <div class="aspect-square size-[.4rem] w-full rounded-full outline outline-white" />
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <ul
      data-slider="arrows"
      class="bg-red px-gx pointer-events-none absolute inset-0 z-10 flex items-center justify-between gap-12 md:justify-end"
    >
      <li data-module="alpha" data-delay=".5">
        <button class="pointer-events-auto" aria-label="previous slide">
          <div class="rotate-180">
            <Svgg name="arrow-r" />
          </div>
        </button>
      </li>

      <li data-module="alpha" data-delay=".7">
        <button class="pointer-events-auto" aria-label="next slide">
          <Svgg name="arrow-r" />
        </button>
      </li>
    </ul>
  </div>

  <div id="tools-panel" data-tools-panel class="tools-panel" aria-hidden="true">
    <button
      type="button"
      data-tools-overlay
      class="tools-overlay"
      tabindex="-1"
      aria-label="Close tools panel"></button>

    <aside
      data-tools-drawer
      class="tools-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Tools"
    >
      <div class="tools-sheet-handle" aria-hidden="true"></div>

      <header class="tools-panel-header">
        <p class="tools-panel-label">CRAWLERS / TOOL INDEX</p>
        <button
          type="button"
          data-tools-close
          class="tools-close"
          aria-label="Close tools panel"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </header>

      <div class="tools-panel-content">
        {
          SLIDER_FOOD.map((section, sectionIndex) => (
            <div data-tools-view data-section-index={sectionIndex} hidden>
              <p class="tools-section-number">
                {String(sectionIndex + 1).padStart(2, "0")} / {section.name}
              </p>
              <h2
                id={`tools-panel-title-${sectionIndex}`}
                class="tools-section-title"
              >
                {section.copy.name}
              </h2>

              <ul class="tools-list">
                {section.tools.map((tool, toolIndex) => (
                  <li style={`--tool-index: ${toolIndex}`}>
                    <a href={tool.href} class="tools-link">
                      <span class="tools-link-number">
                        {String(toolIndex + 1).padStart(2, "0")}
                      </span>
                      <span class="tools-link-name">{tool.name}</span>
                      <span class="tools-link-arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </aside>
  </div>
</section>

<style>
  [data-slider="controls"] button {
    transition: background-color 0.3s ease-in-out;
  }

  [data-slider="controls"] .active button {
    background-color: white;
    pointer-events: none;
  }

  .tools-trigger {
    cursor: grab;
    touch-action: pan-y;
  }

  .tools-trigger:active {
    cursor: grabbing;
  }

  .tools-trigger:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.7);
    outline-offset: -1px;
  }

  .tools-trigger-label {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(4, 4, 4, 0.42);
    color: rgba(255, 255, 255, 0.8);
    font-family: "Geist Mono", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    pointer-events: none;
    opacity: 0;
    transform: translateY(0.35rem);
    backdrop-filter: blur(10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .tools-trigger:hover .tools-trigger-label,
  .tools-trigger:focus-visible .tools-trigger-label {
    opacity: 1;
    transform: translateY(0);
    border-color: rgba(255, 255, 255, 0.42);
  }

  .tools-panel {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
  }

  .tools-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: rgba(0, 0, 0, 0.44);
    opacity: 0;
    cursor: default;
    backdrop-filter: blur(0);
    transition:
      opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      backdrop-filter 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tools-drawer {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    width: min(38rem, 44vw);
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(255, 255, 255, 0.07),
        transparent 36%
      ),
      rgba(7, 7, 7, 0.93);
    box-shadow: -2rem 0 7rem rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translate3d(102%, 0, 0);
    transition:
      transform 0.62s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease;
    will-change: transform;
  }

  [data-panel-open="true"] .tools-panel {
    pointer-events: auto;
  }

  [data-panel-open="true"] .tools-overlay {
    opacity: 1;
    backdrop-filter: blur(7px);
  }

  [data-panel-open="true"] .tools-drawer {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .tools-sheet-handle {
    display: none;
  }

  .tools-panel-header {
    display: flex;
    min-height: 7.25rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .tools-panel-label,
  .tools-section-number,
  .tools-link-number {
    font-family: "Geist Mono", monospace;
    text-transform: uppercase;
  }

  .tools-panel-label {
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
  }

  .tools-close {
    position: relative;
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    flex: none;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    background: transparent;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .tools-close span {
    position: absolute;
    width: 0.95rem;
    height: 1px;
    background: #fff;
  }

  .tools-close span:first-child {
    transform: rotate(45deg);
  }

  .tools-close span:last-child {
    transform: rotate(-45deg);
  }

  .tools-close:hover,
  .tools-close:focus-visible {
    border-color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.08);
    outline: none;
    transform: rotate(6deg);
  }

  .tools-panel-content {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(2rem, 5vw, 4.5rem) 2rem 2rem;
  }

  .tools-section-number {
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.43);
    font-size: 0.67rem;
    letter-spacing: 0.2em;
  }

  .tools-section-title {
    max-width: 9ch;
    color: #fff;
    font-size: clamp(2.65rem, 4.5vw, 4.8rem);
    font-weight: 600;
    letter-spacing: -0.075em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .tools-list {
    margin-top: clamp(2.7rem, 7vh, 5.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .tools-list li {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  [data-panel-open="true"] [data-tools-view]:not([hidden]) .tools-list li {
    animation: tools-row-in 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.16s + var(--tool-index) * 0.06s);
  }

  .tools-link {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    gap: 0.8rem;
    align-items: center;
    min-height: 5rem;
    padding: 0.75rem 0.9rem 0.75rem 0;
    color: #fff;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      padding 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tools-link-number {
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
  }

  .tools-link-name {
    font-size: 1rem;
    letter-spacing: -0.025em;
  }

  .tools-link-arrow {
    font-size: 1.35rem;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tools-link:hover,
  .tools-link:focus-visible {
    padding-left: 0.8rem;
    background: rgba(255, 255, 255, 0.055);
    outline: none;
  }

  .tools-link:hover .tools-link-arrow,
  .tools-link:focus-visible .tools-link-arrow {
    transform: translateX(0.35rem);
  }

  :global(html.tools-panel-open),
  :global(html.tools-panel-open body) {
    overflow: hidden;
  }

  @keyframes tools-row-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .tools-trigger-label {
      right: 0.65rem;
      bottom: 0.65rem;
      opacity: 0.72;
      transform: none;
    }

    .tools-drawer {
      top: auto;
      bottom: 0;
      width: 100%;
      height: min(66svh, 40rem);
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      border-left: 0;
      border-radius: 1.35rem 1.35rem 0 0;
      background:
        radial-gradient(
          circle at 100% 0%,
          rgba(255, 255, 255, 0.08),
          transparent 42%
        ),
        rgba(7, 7, 7, 0.94);
      box-shadow: 0 -2rem 6rem rgba(0, 0, 0, 0.55);
      transform: translate3d(0, 102%, 0);
    }

    [data-panel-open="true"] .tools-drawer {
      transform: translate3d(0, 0, 0);
    }

    .tools-sheet-handle {
      position: absolute;
      top: 0.7rem;
      left: 50%;
      display: block;
      width: 2.7rem;
      height: 0.2rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.28);
      transform: translateX(-50%);
    }

    .tools-panel-header {
      min-height: 5.25rem;
      padding: 1rem 1.25rem;
    }

    .tools-panel-label {
      font-size: 0.62rem;
    }

    .tools-close {
      width: 2.65rem;
      height: 2.65rem;
    }

    .tools-panel-content {
      padding: 1.7rem 1.25rem 1.25rem;
    }

    .tools-section-number {
      margin-bottom: 0.7rem;
    }

    .tools-section-title {
      max-width: 12ch;
      font-size: clamp(2.2rem, 11vw, 3.5rem);
    }

    .tools-list {
      margin-top: 2rem;
    }

    .tools-link {
      min-height: 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tools-overlay,
    .tools-drawer,
    .tools-trigger-label,
    .tools-link,
    .tools-link-arrow,
    .tools-close {
      transition-duration: 0.01ms;
    }

    [data-panel-open="true"] [data-tools-view]:not([hidden]) .tools-list li {
      animation: none;
    }
  }
</style>
