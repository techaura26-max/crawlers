---
import Svgg from "~/components/svg/Svgg.astro"
import { SLIDER_FOOD } from "../../../homepage/categories"
import ToolsPanel from "../../homepage/ToolsPanel.astro"
import "../../../homepage/home.css"
import "../../../homepage/tools-panel.css"

const SLIDES = Array.from({ length: SLIDER_FOOD.length }, (_, i) => i)
const firstSlide = SLIDER_FOOD[0]
const totalSlides = String(SLIDER_FOOD.length).padStart(2, "0")
---

<section
  class="home-experience"
  data-module="fslider"
  data-panel-open="false"
  data-active-index="0"
  style={`--active-accent: ${firstSlide.accent}; --active-rgb: ${firstSlide.accentRgb};`}
>
  <div class="experience-atmosphere" aria-hidden="true">
    <div class="experience-glow"></div>
    <div class="experience-orbit experience-orbit-one"></div>
    <div class="experience-orbit experience-orbit-two"></div>
    <div class="experience-scanline"></div>
  </div>

  <div class="experience-rail" aria-hidden="true">
    <span class="experience-rail-line"></span>
    <span>CURATED DIGITAL UTILITIES</span>
    <span class="experience-rail-line"></span>
  </div>

  <div class="slider-viewport">
    <ul data-slider="wrapper" class="slider-track">
      {
        SLIDER_FOOD.map((slide, i) => (
          <li
            data-slider-item
            data-section-index={i}
            class:list={["slider-item", i === 0 && "active"]}
          >
            <button
              type="button"
              data-gl
              data-tools-trigger
              data-section-index={i}
              aria-controls="tools-panel"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-label={`Open ${slide.copy.name}`}
              aria-current={i === 0 ? "true" : undefined}
              class="tools-trigger"
            >
              <span class="model-frame" aria-hidden="true">
                <>
                  <span />
                  <span />
                  <span />
                  <span />
                </>
              </span>
              <span class="tools-trigger-label" aria-hidden="true">
                <span>Open collection</span>
                <span>↗</span>
              </span>
            </button>

            <div class="slide-caption">
              <p class="slide-kicker">
                <span>{String(i + 1).padStart(2, "0")}</span>
                <span>{slide.shortName}</span>
              </p>
              <h2 data-module="text" data-type="chars" class="slide-title">
                {slide.copy.name}
              </h2>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="active-brief" aria-live="polite" aria-atomic="true">
    <p class="active-brief-index">
      <span data-active-index>01</span>
      <span>/</span>
      <span>{totalSlides}</span>
    </p>
    <p data-active-description>{firstSlide.copy.description}</p>
  </div>

  <p class="gesture-note" aria-hidden="true">
    <span class="gesture-line"></span>
    Hold + drag to explore
  </p>

  <div data-no-cursor class="slider-navigation">
    <ul data-slider="arrows" class="slider-arrows">
      <li data-module="alpha" data-delay=".5">
        <button class="slider-arrow" aria-label="Previous category">
          <span class="rotate-180"><Svgg name="arrow-r" /></span>
        </button>
      </li>
      <li data-module="alpha" data-delay=".7">
        <button class="slider-arrow" aria-label="Next category">
          <span><Svgg name="arrow-r" /></span>
        </button>
      </li>
    </ul>

    <div data-slider="controls" class="slider-dots-wrap">
      <ul class="slider-dots" aria-label="Choose a category">
        {
          SLIDES.map((slide, i) => (
            <li
              data-module="alpha"
              data-delay={1 + i * 0.12}
              class:list={i === 0 && "active"}
            >
              <button
                aria-label={`Go to category ${slide + 1}: ${SLIDER_FOOD[i].copy.name}`}
                aria-current={i === 0 ? "true" : undefined}
              >
                <span />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <ToolsPanel />
</section>
