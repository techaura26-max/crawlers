---
import Svgg from "~/components/svg/Svgg.astro"
import { SLIDER_FOOD } from "../../../homepage/categories"

import ToolsPanel from "../../homepage/ToolsPanel.astro"
import "../../../homepage/tools-panel.css"

const SLIDES = Array.from({ length: SLIDER_FOOD.length }, (_, i) => i)
---

<section
  class="gap-lg relative flex h-full w-full flex-col justify-center py-4
         [--slide-w:72vw]
         sm:[--slide-w:60vw]
         md:[--slide-w:44vw]
         lg:[--slide-w:clamp(18rem,25vw,30rem)]"
  data-module="fslider"
  data-panel-open="false"
>
  <!-- slider -->
  <div class="w-full overflow-clip">
    <ul
      data-slider="wrapper"
      class="ml-[calc((50vw-var(--slide-w)/2)-2rem)] flex text-[.8em]"
    >
      {
        SLIDER_FOOD.map((slide, i) => (
          <li
            class:list={[
              "z-2 relative flex shrink-0 flex-col gap-2 px-[0.75rem] sm:px-[1.25rem] lg:px-[2rem]",
              i === 0 && "active",
            ]}
          >
            <button
              type="button"
              data-gl
              data-tools-trigger
              data-section-index={i}
              aria-controls="tools-panel"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-label={`Open ${slide.copy.name}`}
              class="tools-trigger relative z-10 block aspect-[4/4.5] w-[var(--slide-w)] appearance-none border-0 bg-transparent p-0 text-white md:aspect-[4/5.5]"
            >
              <span class="sr-only">Open {slide.copy.name}</span>
              <span class="tools-trigger-label" aria-hidden="true">
                Explore <span>↗</span>
              </span>
            </button>

            {/* centered slide name */}
            <div class="flex justify-center px-2">
              <h2
                data-module="text"
                data-type="chars"
                class="text-center text-xl font-semibold uppercase tracking-tighter"
              >
                {slide.copy.name}
              </h2>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

<!-- bottom ui -->
<div
  data-no-cursor
  class="fixed inset-x-0 bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 flex justify-center -outline-offset-1"
>
    <div data-slider="controls" class="flex flex-col gap-2">
      <ul class="flex gap-[1rem]">
        {
          SLIDES.map((slide, i) => (
            <li
              data-module="alpha"
              data-delay={1 + i * 0.2}
              class:list={i === 0 && "active"}
            >
              <button aria-label={`slide number ${slide}`}>
                <div class="aspect-square size-[.4rem] w-full rounded-full outline outline-white" />
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <ul
  data-slider="arrows"
  class="px-gx pointer-events-none absolute inset-0 z-10 flex items-center justify-between gap-12"
>
      <li data-module="alpha" data-delay=".5">
        <button class="pointer-events-auto" aria-label="previous slide">
          <div class="rotate-180">
            <Svgg name="arrow-r" />
          </div>
        </button>
      </li>

      <li data-module="alpha" data-delay=".7">
        <button class="pointer-events-auto" aria-label="next slide">
          <Svgg name="arrow-r" />
        </button>
      </li>
    </ul>
  </div>

  <ToolsPanel />
</section>
